<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 replaced windowBackground with its own splash screen and
         will show one whether we configure it or not. Left alone it draws the
         launcher icon inside a circular mask at a fraction of the screen,
         which is why the logo appeared tiny before the Flutter splash took
         over. Pointing it at a purpose-built 288dp icon and a white
         background makes the system splash match the Flutter one, so the
         handover is invisible. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
