<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The night qualifier outranks the version qualifier, so without this
         file a dark-mode phone on Android 12+ would fall back to
         values-night and lose the splash configuration entirely. The app
         renders light-only, so the splash stays white in both modes rather
         than flashing black before the Flutter UI appears. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
