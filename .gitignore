# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS CocoaPods — generated by `pod install`, never commit
ios/Pods/
ios/.symlinks/

# Firebase Functions
functions/node_modules/
functions/lib/
tools/raw_images/
tools/products_seed.json
tools/*service*.json
tools/*-key.json

# Android release signing — the upload key is the only thing that can publish
# an update to this listing. Losing it means a new listing; leaking it means
# someone else can sign one. Neither file ever belongs in the repo.
android/key.properties
*.jks
*.keystore

# Generated by flutter gen-l10n: lists ARB keys not yet translated. Regenerated
# on every build, so it is a report rather than source.
l10n_missing.txt
