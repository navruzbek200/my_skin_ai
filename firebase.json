{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "//": "Product art is content-addressed by filename — a changed picture gets a new name, so it can be cached forever. Without this Hosting sends max-age=3600 and every phone re-downloads the catalogue hourly.",
        "source": "/products/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "real-beauty-2b6b0",
          "appId": "1:211589998133:android:e4258d76e58e88a844f37c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "real-beauty-2b6b0",
          "appId": "1:211589998133:ios:d9df8ab04bfc9aba44f37c",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "real-beauty-2b6b0",
          "configurations": {
            "android": "1:211589998133:android:a3682bd854e1024044f37c",
            "ios": "1:211589998133:ios:d9df8ab04bfc9aba44f37c"
          }
        }
      }
    }
  }
}
